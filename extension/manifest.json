{
  "manifest_version": 3,
  "name": "Extension Something",
  "version": "1.0.0",
  "description": "Dummy webextension that logs on every site.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
